{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vitest",
      "vitest/globals",
      "node"
    ],
    // path mapping cfg
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src"
      ],
      "@components/*": [
        "src/components"
      ],
      "@utils/*": [
        "src/utils/*"
      ]
    }
    // end of path mapping cfg
  },
  "include": [
    "src",
    "test"
  ]
}